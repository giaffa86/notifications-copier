#: extension.js:117
msgid "Token Copied"
msgstr "Jeton copié"

#: prefs.js:32 prefs.js:56 prefs.js:104
msgid "Reset to default"
msgstr "Rétablir la valeur par défaut"

#: prefs.js:120
msgid "Last copied token"
msgstr "Dernier jeton copié"

#: prefs.js:121
msgid "Clear the remembered token so the same code can be copied again"
msgstr "Effacer le jeton mémorisé pour pouvoir copier à nouveau le même code"

#: prefs.js:125
msgid "Clear"
msgstr "Effacer"

#: prefs.js:146
msgid "General"
msgstr "Général"

#: prefs.js:152
msgid "Behaviour"
msgstr "Comportement"

#: prefs.js:153
msgid "Configure automatic token detection and copying"
msgstr "Configurer la détection et la copie automatiques des jetons"

#: prefs.js:160
msgid "Auto-copy tokens"
msgstr "Copier automatiquement les jetons"

#: prefs.js:161
msgid "Automatically copy detected tokens and PINs to the clipboard"
msgstr ""
"Copier automatiquement les jetons et les codes PIN détectés dans le presse-"
"papiers"

#: prefs.js:167
msgid "Show confirmation"
msgstr "Afficher une confirmation"

#: prefs.js:168
msgid "Show a notification when a token is copied to the clipboard"
msgstr ""
"Afficher une notification lorsqu’un jeton est copié dans le presse-papiers"

#: prefs.js:172
msgid "Patterns"
msgstr "Critères de détection"

#: prefs.js:173
msgid ""
"Keywords are comma-separated and matched case-insensitively against "
"notification text."
msgstr ""
"Les mots-clés sont séparés par des virgules et recherchés dans le texte des "
"notifications sans tenir compte de la casse."

#: prefs.js:180
msgid "Token keywords"
msgstr "Mots-clés des jetons"

#: prefs.js:184
msgid "PIN Range"
msgstr "Longueur du code PIN"

#: prefs.js:185
msgid "Numeric code digit range for keyword-based detection."
msgstr ""
"Nombre de chiffres autorisé pour les codes numériques détectés à l’aide de "
"mots-clés."

#: prefs.js:192
msgid "Minimum PIN digits"
msgstr "Nombre minimal de chiffres du PIN"

#: prefs.js:193
msgid "Minimum number of digits to consider a numeric sequence as a PIN"
msgstr ""
"Nombre minimal de chiffres pour considérer une suite numérique comme un code "
"PIN"

#: prefs.js:201
msgid "Maximum PIN digits"
msgstr "Nombre maximal de chiffres du PIN"

#: prefs.js:202
msgid "Maximum number of digits to consider a numeric sequence as a PIN"
msgstr ""
"Nombre maximal de chiffres pour considérer une suite numérique comme un code "
"PIN"

#: prefs.js:208
msgid "Alphanumeric Fallback"
msgstr "Recherche alphanumérique de secours"

#: prefs.js:209
msgid ""
"When no numeric PIN is found near a keyword, an alphanumeric token is "
"searched instead."
msgstr ""
"Si aucun code PIN numérique n’est trouvé près d’un mot-clé, un jeton "
"alphanumérique est recherché à la place."

#: prefs.js:216
msgid "Minimum token length"
msgstr "Longueur minimale du jeton"

#: prefs.js:217
msgid "Minimum character length for alphanumeric token fallback"
msgstr ""
"Nombre minimal de caractères pour la recherche alphanumérique de secours"

#: prefs.js:225
msgid "Maximum token length"
msgstr "Longueur maximale du jeton"

#: prefs.js:226
msgid "Maximum character length for alphanumeric token fallback"
msgstr ""
"Nombre maximal de caractères pour la recherche alphanumérique de secours"

#: prefs.js:232
msgid "State"
msgstr "État"

#: prefs.js:233
msgid "Troubleshooting helpers"
msgstr "Outils de dépannage"
