#: extension.js:117
msgid "Token Copied"
msgstr "Token copiado"

#: prefs.js:32 prefs.js:56 prefs.js:104
msgid "Reset to default"
msgstr "Restablecer el valor predeterminado"

#: prefs.js:120
msgid "Last copied token"
msgstr "Último token copiado"

#: prefs.js:121
msgid "Clear the remembered token so the same code can be copied again"
msgstr "Borrar el token recordado para poder volver a copiar el mismo código"

#: prefs.js:125
msgid "Clear"
msgstr "Borrar"

#: prefs.js:146
msgid "General"
msgstr "General"

#: prefs.js:152
msgid "Behaviour"
msgstr "Comportamiento"

#: prefs.js:153
msgid "Configure automatic token detection and copying"
msgstr "Configurar la detección y copia automática de tokens"

#: prefs.js:160
msgid "Auto-copy tokens"
msgstr "Copiar tokens automáticamente"

#: prefs.js:161
msgid "Automatically copy detected tokens and PINs to the clipboard"
msgstr "Copiar automáticamente al portapapeles los tokens y PIN detectados"

#: prefs.js:167
msgid "Show confirmation"
msgstr "Mostrar confirmación"

#: prefs.js:168
msgid "Show a notification when a token is copied to the clipboard"
msgstr "Mostrar una notificación al copiar un token al portapapeles"

#: prefs.js:172
msgid "Patterns"
msgstr "Patrones"

#: prefs.js:173
msgid ""
"Keywords are comma-separated and matched case-insensitively against "
"notification text."
msgstr ""
"Las palabras clave se separan por comas y se buscan en el texto de las "
"notificaciones sin distinguir mayúsculas y minúsculas."

#: prefs.js:180
msgid "Token keywords"
msgstr "Palabras clave de los tokens"

#: prefs.js:184
msgid "PIN Range"
msgstr "Intervalo de dígitos del PIN"

#: prefs.js:185
msgid "Numeric code digit range for keyword-based detection."
msgstr ""
"Intervalo del número de dígitos de los códigos numéricos para la detección "
"por palabras clave."

#: prefs.js:192
msgid "Minimum PIN digits"
msgstr "Mínimo de dígitos del PIN"

#: prefs.js:193
msgid "Minimum number of digits to consider a numeric sequence as a PIN"
msgstr ""
"Número mínimo de dígitos para considerar una secuencia numérica como PIN"

#: prefs.js:201
msgid "Maximum PIN digits"
msgstr "Máximo de dígitos del PIN"

#: prefs.js:202
msgid "Maximum number of digits to consider a numeric sequence as a PIN"
msgstr ""
"Número máximo de dígitos para considerar una secuencia numérica como PIN"

#: prefs.js:208
msgid "Alphanumeric Fallback"
msgstr "Búsqueda alternativa alfanumérica"

#: prefs.js:209
msgid ""
"When no numeric PIN is found near a keyword, an alphanumeric token is "
"searched instead."
msgstr ""
"Si no se encuentra un PIN numérico cerca de una palabra clave, se busca un "
"token alfanumérico."

#: prefs.js:216
msgid "Minimum token length"
msgstr "Longitud mínima del token"

#: prefs.js:217
msgid "Minimum character length for alphanumeric token fallback"
msgstr ""
"Número mínimo de caracteres para la búsqueda alternativa de tokens "
"alfanuméricos"

#: prefs.js:225
msgid "Maximum token length"
msgstr "Longitud máxima del token"

#: prefs.js:226
msgid "Maximum character length for alphanumeric token fallback"
msgstr ""
"Número máximo de caracteres para la búsqueda alternativa de tokens "
"alfanuméricos"

#: prefs.js:232
msgid "State"
msgstr "Estado"

#: prefs.js:233
msgid "Troubleshooting helpers"
msgstr "Herramientas para resolver problemas"
