#: extension.js:117
msgid "Token Copied"
msgstr "Token copiato"

#: prefs.js:32 prefs.js:56 prefs.js:104
msgid "Reset to default"
msgstr "Ripristina il valore predefinito"

#: prefs.js:120
msgid "Last copied token"
msgstr "Ultimo token copiato"

#: prefs.js:121
msgid "Clear the remembered token so the same code can be copied again"
msgstr ""
"Cancella il token memorizzato per poter copiare di nuovo lo stesso codice"

#: prefs.js:125
msgid "Clear"
msgstr "Cancella"

#: prefs.js:146
msgid "General"
msgstr "Generale"

#: prefs.js:152
msgid "Behaviour"
msgstr "Comportamento"

#: prefs.js:153
msgid "Configure automatic token detection and copying"
msgstr "Configura il rilevamento e la copia automatica dei token"

#: prefs.js:160
msgid "Auto-copy tokens"
msgstr "Copia automaticamente i token"

#: prefs.js:161
msgid "Automatically copy detected tokens and PINs to the clipboard"
msgstr "Copia automaticamente negli appunti i token e i PIN rilevati"

#: prefs.js:167
msgid "Show confirmation"
msgstr "Mostra la conferma"

#: prefs.js:168
msgid "Show a notification when a token is copied to the clipboard"
msgstr "Mostra una notifica quando un token viene copiato negli appunti"

#: prefs.js:172
msgid "Patterns"
msgstr "Criteri di riconoscimento"

#: prefs.js:173
msgid ""
"Keywords are comma-separated and matched case-insensitively against "
"notification text."
msgstr ""
"Le parole chiave sono separate da virgole e cercate nel testo delle "
"notifiche senza distinguere maiuscole e minuscole."

#: prefs.js:180
msgid "Token keywords"
msgstr "Parole chiave per i token"

#: prefs.js:184
msgid "PIN Range"
msgstr "Intervallo delle cifre del PIN"

#: prefs.js:185
msgid "Numeric code digit range for keyword-based detection."
msgstr ""
"Intervallo del numero di cifre dei codici numerici per il rilevamento "
"tramite parole chiave."

#: prefs.js:192
msgid "Minimum PIN digits"
msgstr "Cifre minime del PIN"

#: prefs.js:193
msgid "Minimum number of digits to consider a numeric sequence as a PIN"
msgstr "Numero minimo di cifre per considerare una sequenza numerica come PIN"

#: prefs.js:201
msgid "Maximum PIN digits"
msgstr "Cifre massime del PIN"

#: prefs.js:202
msgid "Maximum number of digits to consider a numeric sequence as a PIN"
msgstr "Numero massimo di cifre per considerare una sequenza numerica come PIN"

#: prefs.js:208
msgid "Alphanumeric Fallback"
msgstr "Ricerca alternativa alfanumerica"

#: prefs.js:209
msgid ""
"When no numeric PIN is found near a keyword, an alphanumeric token is "
"searched instead."
msgstr ""
"Se non viene trovato un PIN numerico vicino a una parola chiave, viene "
"cercato un token alfanumerico."

#: prefs.js:216
msgid "Minimum token length"
msgstr "Lunghezza minima del token"

#: prefs.js:217
msgid "Minimum character length for alphanumeric token fallback"
msgstr ""
"Numero minimo di caratteri per la ricerca alternativa di token alfanumerici"

#: prefs.js:225
msgid "Maximum token length"
msgstr "Lunghezza massima del token"

#: prefs.js:226
msgid "Maximum character length for alphanumeric token fallback"
msgstr ""
"Numero massimo di caratteri per la ricerca alternativa di token alfanumerici"

#: prefs.js:232
msgid "State"
msgstr "Stato"

#: prefs.js:233
msgid "Troubleshooting helpers"
msgstr "Strumenti per la risoluzione dei problemi"
